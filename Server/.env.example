# Адрес подключения к PostgreSQL
# Локальная разработка (docker compose)
DATABASE_URL="postgresql://ultrasound:ultrasound_password@localhost:5432/ultrasound"

# Секрет для подписи JWT-токенов (замените на случайную строку!)
JWT_SECRET="change-me-to-a-long-random-string"

# Порт API-сервера
PORT=4000