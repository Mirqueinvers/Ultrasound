# Адрес подключения к PostgreSQL
# - для локального запуска API вне Docker: localhost
# - внутри docker compose задаётся автоматически (postgres:5432)
DATABASE_URL="postgresql://ultrasound:ultrasound_password@localhost:5432/ultrasound"

# Секрет для подписи JWT-токенов (обязателен, сгенерирован случайно)
JWT_SECRET="261b8a4c3c0e0d4eb7dd800fee6bb27ba097407fe4d9ce714cc04c14f209fee761cdbe1926a07282ee6689ac9b6978bd"

# Порт API-сервера
PORT=4000

# ---- Параметры PostgreSQL для docker compose (.env читается автоматически) ----
POSTGRES_USER=ultrasound
POSTGRES_PASSWORD=ultrasound_password
POSTGRES_DB=ultrasound
POSTGRES_PORT=5432
API_PORT=4000
